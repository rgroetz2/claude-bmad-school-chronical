# Development image — Angular CLI dev server with hot reload
FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
RUN npm install

# Source mounted as volume at runtime
EXPOSE 4200

# --host 0.0.0.0 required to be accessible from host machine
CMD ["npm", "run", "start", "--", "--host", "0.0.0.0", "--poll", "2000"]
