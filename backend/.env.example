# ── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200

# ── Database (PostgreSQL — local, not Docker) ─────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=schoolchronicle
DB_PASSWORD=schoolchronicle
DB_NAME=schoolchronicle

# ── Redis (local, not Docker) ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ── MinIO (local, not Docker) ─────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=schoolchronicle
MINIO_USE_SSL=false

# ── JWT ───────────────────────────────────────────────────────────────────────
# For production: generate RS256 key pair (see README.md)
# JWT_PRIVATE_KEY=<contents of private.pem>
# JWT_PUBLIC_KEY=<contents of public.pem>
#
# For local development without keys: HS256 fallback is used automatically
JWT_SECRET=dev-secret-change-me-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:4200

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# For local dev: use Mailpit (brew install mailpit) running on port 1025
# Mailpit web UI: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM="SchoolCronicle" <noreply@schoolchronicle.local>
